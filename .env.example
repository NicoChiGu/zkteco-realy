# Generate a long random secret. Do not commit the real .env file.
ZKTECO_API_KEY=replace-with-at-least-32-random-characters

# Bind to loopback by default. For LAN access, use a specific private IP instead of 0.0.0.0 when possible.
ZKTECO_BIND_URL=http://127.0.0.1:5080

# GitHub Release update settings used by the GUI manager.
ZKTECO_UPDATE_REPOSITORY=NicoChiGu/zkteco-realy
# Optional proxy prefix. Leave empty to use GitHub directly.
# Example: https://v4.gh-proxy.org/
ZKTECO_GITHUB_PROXY=

# SQLite device configuration database. Relative paths are resolved from the process working directory.
ZKTECO_DATABASE_PATH=

# GUI behavior.
ZKTECO_MINIMIZE_TO_TRAY=true
